# ==============================================================================
# PreCare SaaS — Environment Variables Template
# Copy this file to .env for local configuration.
# Never commit .env or real secrets to version control.
# ==============================================================================

# Frontend Configuration (Vercel / Vite)
# Local: leave blank (or http://localhost:8000)
# Production on Vercel: https://precare-1.onrender.com
VITE_API_URL=https://precare-1.onrender.com

# Backend Configuration (FastAPI / Render)
# Production defaults to OpenRouter. Never fall back to Ollama in production.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=openrouter/free
DEV_SECRET=precare-dev-secret-key

# Optional Local Developer AI Configuration (Ollama)
# Switch AI_PROVIDER=ollama only for local developer testing
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Database & Security Configuration (Render)
# Set these in Render Dashboard -> Environment:
DATABASE_URL=postgresql://user:pass@host/db
SECRET_KEY=your-production-secret-key
CORS_ORIGINS=https://precare-five.vercel.app
ENVIRONMENT=production
