# ==============================================================================
# PreCare SaaS — Environment Variables Template
# Copy this file to .env for local configuration.
# Never commit .env or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Security
# ------------------------------------------------------------------------------
# Environment: 'development' or 'production'
ENVIRONMENT=development

# Production Secret Key (REQUIRED when ENVIRONMENT=production)
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_hex_secret_in_production

# CORS Origins: Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-precare-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration ($0 Free-Tier Compatible)
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///./precare.sqlite

# Production ($0 Free PostgreSQL on Neon / Supabase / Render):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/precare?sslmode=require

# ------------------------------------------------------------------------------
# AI Inference Configuration ($0 Free-Tier)
# ------------------------------------------------------------------------------
# Provider choice: 'ollama' (local development) or 'groq' (free online API)
AI_PROVIDER=ollama

# Option A: Local Ollama (Default for local development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Option B: Free-Tier Online AI (For production without local GPU)
# e.g., Groq Free Tier (console.groq.com)
# AI_PROVIDER=groq
# AI_API_BASE=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your_free_groq_api_key_here
# AI_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Vite)
# ------------------------------------------------------------------------------
# Backend API URL for production deployment (set in Vercel project settings)
VITE_API_URL=https://precare-1.onrender.com
